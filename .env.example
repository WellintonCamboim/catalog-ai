# Used by docker compose (copy to .env) and, for local runs, by api/.env.
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRES_IN=1d
WEB_PORT=8080

# LLM: anthropic | openrouter
LLM_PROVIDER=anthropic
# Optional. Defaults: claude-haiku-5-5 (anthropic), dots-studio/dots-3-note-preview:free (openrouter)
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Local (non-Docker) API only
PORT=3000
MONGODB_URI=mongodb://localhost:27017/catalog_ai
CORS_ORIGIN=http://localhost:5173
