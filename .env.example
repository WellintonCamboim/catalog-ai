# Used by docker compose (copy to .env) and, for local runs, by api/.env.
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRES_IN=1d
WEB_PORT=8080

# LLM via OpenRouter. Create a key at https://openrouter.ai/keys (see the README, "Setting up the AI").
OPENROUTER_API_KEY=
# Optional. Any OpenRouter model that supports tool calling, e.g. openai/gpt-4.1-mini or anthropic/claude-haiku-5.5.
# Default when empty: dots-studio/dots-3-note-preview:free (free preview model, may change or disappear).
LLM_MODEL=

# Local (non-Docker) API only
PORT=3000
MONGODB_URI=mongodb://localhost:27017/catalog_ai
CORS_ORIGIN=http://localhost:5173
